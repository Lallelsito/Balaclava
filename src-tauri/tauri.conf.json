{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Balaclava",
  "version": "0.1.0",
  "identifier": "com.vicestudios.balaclava",
  "build": {
    "beforeBuildCommand": "node scripts/prepare_dist.cjs",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Balaclava Beta 1.0.0",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
