{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Balaclava",
  "version": "1.3.0",
  "identifier": "com.vicestudios.balaclava",
  "build": {
    "beforeBuildCommand": "node scripts/prepare_dist.cjs",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Balaclava Beta 1.3.0",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vice Studios",
    "copyright": "Copyright (c) 2026 Vice Studios",
    "category": "Game",
    "shortDescription": "2D Pixel-Art Survival & Fantasy RPG",
    "longDescription": "Balaclava is a 2D pixel-art survival, crafting, base-building, and fantasy action RPG featuring 14 biomes, 361 unlockable islands, 75 dungeons, and an Astral Constellation skill tree.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
